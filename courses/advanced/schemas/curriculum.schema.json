{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HashCode Academy advanced curriculum",
  "type": "object",
  "required": [
    "schemaVersion",
    "language",
    "brand",
    "series",
    "modules"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "language": {
      "const": "fr"
    },
    "brand": {
      "type": "string",
      "minLength": 1
    },
    "series": {
      "type": "string",
      "minLength": 1
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "number",
          "title",
          "presentation",
          "status",
          "level",
          "prerequisites",
          "resources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "presentation": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "planned",
              "presentation",
              "course",
              "complete"
            ]
          },
          "level": {
            "enum": [
              "beginner",
              "intermediate",
              "advanced"
            ]
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resources": {
            "type": "object",
            "required": [
              "course",
              "examples",
              "labs",
              "exercises",
              "solutions",
              "quiz",
              "rubric"
            ],
            "properties": {
              "course": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "examples": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "labs": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "exercises": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "solutions": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "quiz": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "rubric": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
