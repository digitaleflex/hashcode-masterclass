{
  "name": "hashcode-masterclass",
  "version": "1.0.0",
  "private": true,
  "description": "Présentation web autonome de la masterclass HashCode JavaScript et TypeScript.",
  "scripts": {
    "start": "npx http-server . -p 4173 -c-1",
    "check": "node scripts/check-slides.mjs",
    "check:exercises": "node scripts/validate-exercises.mjs",
    "test": "node --test tests/*.test.mjs exercises/EX-JS-001-panier/tests/*.test.mjs",
    "check:links": "node scripts/check-markdown-links.mjs",
    "check:types": "npx --yes --package typescript@5.9.3 tsc --noEmit -p exercises/typescript/tsconfig.json"
  },
  "devDependencies": {
    "http-server": "^14.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
