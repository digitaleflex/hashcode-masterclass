{
  "name": "hashcode-masterclass",
  "version": "1.0.0",
  "private": true,
  "description": "Présentation web autonome de la masterclass HashCode JavaScript et TypeScript.",
  "scripts": {
    "start": "npx http-server . -p 4173 -c-1",
    "check": "node scripts/check-slides.mjs",
    "check:exercises": "node scripts/validate-exercises.mjs",
    "test": "node --test tests/*.test.mjs courses/advanced/*/examples/*.test.mjs",
    "check:repo": "node scripts/check-repository.mjs",
    "check:types": "npx --yes --package=typescript@5.9.3 tsc --strict --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext courses/advanced/02-typescript-avance/examples/advanced-types.ts"
  },
  "devDependencies": {
    "http-server": "^14.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
