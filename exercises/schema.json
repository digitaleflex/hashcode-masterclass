{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joinhashcode.com/schemas/exercise-curriculum.schema.json",
  "title": "HashCode Masterclass exercise curriculum",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "language", "levels", "exerciseGuide", "exerciseCount", "exercises"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "title": { "type": "string", "minLength": 1 },
    "language": { "const": "fr" },
    "levels": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["INIT", "CORE", "PRO"] },
      "minItems": 3,
      "maxItems": 3
    },
    "exerciseGuide": { "type": "string", "minLength": 1 },
    "exerciseCount": { "type": "integer", "minimum": 1 },
    "exercises": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "level"],
        "properties": {
          "id": { "type": "string", "pattern": "^EX-[A-Z]+-[0-9]{3}$" },
          "title": { "type": "string", "minLength": 1 },
          "level": { "enum": ["INIT", "CORE", "PRO"] }
        }
      }
    }
  }
}
